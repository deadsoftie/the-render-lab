#version 430 core

// Blelloch exclusive scan, 512 values per block; block totals go to scanSums.
layout(local_size_x = 256) in;

layout(std430, binding = 11) readonly buffer ScanIn { uint scanIn[]; };
layout(std430, binding = 12) writeonly buffer ScanOut { uint scanOut[]; };
layout(std430, binding = 13) writeonly buffer ScanSums { uint scanSums[]; };

uniform int uCount;

shared uint temp[512];

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.x * 512u;
    uint count = uint(uCount);
    uint ai = tid;
    uint bi = tid + 256u;

    temp[ai] = base + ai < count ? scanIn[base + ai] : 0u;
    temp[bi] = base + bi < count ? scanIn[base + bi] : 0u;

    // Up-sweep.
    uint offset = 1u;
    for (uint d = 256u; d > 0u; d >>= 1u)
    {
        memoryBarrierShared();
        barrier();
        if (tid < d)
        {
            uint a = offset * (2u * tid + 1u) - 1u;
            uint b = offset * (2u * tid + 2u) - 1u;
            temp[b] += temp[a];
        }
        offset <<= 1u;
    }

    memoryBarrierShared();
    barrier();
    if (tid == 0u)
    {
        scanSums[gl_WorkGroupID.x] = temp[511];
        temp[511] = 0u;
    }

    // Down-sweep.
    for (uint d = 1u; d < 512u; d <<= 1u)
    {
        offset >>= 1u;
        memoryBarrierShared();
        barrier();
        if (tid < d)
        {
            uint a = offset * (2u * tid + 1u) - 1u;
            uint b = offset * (2u * tid + 2u) - 1u;
            uint t = temp[a];
            temp[a] = temp[b];
            temp[b] += t;
        }
    }

    memoryBarrierShared();
    barrier();
    if (base + ai < count)
        scanOut[base + ai] = temp[ai];
    if (base + bi < count)
        scanOut[base + bi] = temp[bi];
}
