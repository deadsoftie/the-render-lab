#version 430 core
#include "pbf_common.glsl"
#include "pbf_bodies.glsl"

layout(local_size_x = PBF_GROUP_SIZE) in;

layout(std430, binding = 1) buffer Predicted { vec4 predicted[]; };
layout(std430, binding = 3) readonly buffer Delta { vec4 delta[]; };

void main()
{
    BeginBodyImpulses();
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(particleCount))
    {
        vec4 p = predicted[i];
        predicted[i] = vec4(Collide(CollideBodies(p.xyz + delta[i].xyz)), p.w);
    }
    EndBodyImpulses();
}
