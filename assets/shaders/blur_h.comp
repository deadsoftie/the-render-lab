#version 430 core
layout(local_size_x = 8, local_size_y = 8) in;

uniform samplerCube uMomentCube;
layout(rgba32f, binding = 0) writeonly uniform image2D uPingPong;

uniform int   uFace;
uniform int   uResolution;
uniform float uBlurStep;

// 7-tap Gaussian weights (sigma ~1.0, normalized)
const float kWeights[7] = float[](
    0.00443, 0.05399, 0.24197, 0.38292, 0.24197, 0.05399, 0.00443
);

// Convert face UV to cubemap direction (OpenGL spec §8.13)
vec3 FaceUVToDir(int face, vec2 uv)
{
    float s = uv.x, t = uv.y;
    if (face == 0) return normalize(vec3( 1.0,  1.0-2.0*t, 1.0-2.0*s));  // +X
    if (face == 1) return normalize(vec3(-1.0,  1.0-2.0*t, 2.0*s-1.0));  // -X
    if (face == 2) return normalize(vec3(2.0*s-1.0,  1.0,  2.0*t-1.0));  // +Y
    if (face == 3) return normalize(vec3(2.0*s-1.0, -1.0,  1.0-2.0*t));  // -Y
    if (face == 4) return normalize(vec3(2.0*s-1.0,  1.0-2.0*t,  1.0));  // +Z
    return            normalize(vec3(1.0-2.0*s,  1.0-2.0*t, -1.0));      // -Z
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= uResolution || coord.y >= uResolution)
        return;

    float invRes = 1.0 / float(uResolution);
    float step   = uBlurStep * invRes;
    vec2  center = (vec2(coord) + 0.5) * invRes;

    vec4 result = vec4(0.0);
    for (int k = 0; k < 7; ++k)
    {
        float delta = float(k - 3) * step;
        vec2  uv    = vec2(center.x + delta, center.y);
        result     += kWeights[k] * texture(uMomentCube, FaceUVToDir(uFace, uv));
    }

    imageStore(uPingPong, coord, result);
}
