#version 430 core
#include "pbf_common.glsl"

layout(local_size_x = PBF_GROUP_SIZE) in;

layout(std430, binding = 0) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding = 2) buffer Velocities { vec4 velocities[]; };

uniform vec3 uRayOrigin;
uniform vec3 uRayDir;
uniform float uRadius;
uniform vec3 uImpulse;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(particleCount))
        return;

    vec3 rel = positions[i].xyz - uRayOrigin;
    float t = dot(rel, uRayDir);
    if (t <= 0.0)
        return;
    float d = length(rel - t * uRayDir);
    if (d >= uRadius)
        return;
    float falloff = 1.0 - d / uRadius;
    velocities[i].xyz += uImpulse * (falloff * falloff);
}
