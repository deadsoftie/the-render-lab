#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;

layout(r32f, binding = 0) readonly uniform image2D uDepthIn;
layout(r32f, binding = 1) writeonly uniform image2D uDepthOut;

uniform vec2 uDirection;
uniform float uWorldRadius;
uniform float uPixelsPerMeter;
uniform float uDepthFalloff;

// Separable bilateral depth filter (alternative to curvature flow).
void main()
{
    ivec2 size = imageSize(uDepthIn);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y)
        return;

    float z = imageLoad(uDepthIn, p).r;
    if (z <= 0.0)
    {
        imageStore(uDepthOut, p, vec4(0.0));
        return;
    }

    float radius = clamp(uWorldRadius * uPixelsPerMeter / z, 1.0, 24.0);
    int taps = int(ceil(radius));
    float sigma = 0.5 * radius;
    ivec2 dir = ivec2(uDirection);
    float sum = 0.0;
    float weights = 0.0;
    for (int k = -taps; k <= taps; ++k)
    {
        ivec2 q = p + dir * k;
        if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y)
            continue;
        float zq = imageLoad(uDepthIn, q).r;
        if (zq <= 0.0)
            continue;
        float dz = (zq - z) / uDepthFalloff;
        float w = exp(-float(k * k) / (2.0 * sigma * sigma)) * exp(-dz * dz);
        sum += zq * w;
        weights += w;
    }
    imageStore(uDepthOut, p, vec4(weights > 0.0 ? sum / weights : z));
}
