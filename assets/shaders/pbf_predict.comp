#version 430 core
#include "pbf_common.glsl"
#include "pbf_bodies.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding = 1) writeonly buffer Predicted { vec4 predicted[]; };
layout(std430, binding = 2) buffer Velocities { vec4 velocities[]; };

void main()
{
    BeginBodyImpulses();
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(particleCount))
    {
        float dt = TimeStep();
        vec3 v = velocities[i].xyz + gravity.xyz * dt;
        velocities[i] = vec4(v, 0.0);
        predicted[i] = vec4(Collide(CollideBodies(positions[i].xyz + v * dt)), 1.0);
    }
    EndBodyImpulses();
}
