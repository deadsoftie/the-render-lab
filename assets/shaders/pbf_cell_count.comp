#version 430 core
#include "pbf_common.glsl"

layout(local_size_x = PBF_GROUP_SIZE) in;

layout(std430, binding = 1) readonly buffer Predicted { vec4 predicted[]; };

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(particleCount))
        return;
    int cell = CellIndex(CellCoord(predicted[i].xyz));
    particleCell[i] = uint(cell);
    particleRank[i] = atomicAdd(cellCount[cell], 1u);
}
