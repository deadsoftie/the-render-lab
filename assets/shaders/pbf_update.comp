#version 430 core
#include "pbf_common.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Positions { vec4 positions[]; };
layout(std430, binding = 1) readonly buffer Predicted { vec4 predicted[]; };
layout(std430, binding = 2) writeonly buffer Velocities { vec4 velocities[]; };

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(particleCount))
        return;
    vec3 x = positions[i].xyz;
    vec3 xStar = predicted[i].xyz;
    velocities[i] = vec4((xStar - x) / TimeStep(), 0.0);
    positions[i] = vec4(xStar, 1.0);
}
