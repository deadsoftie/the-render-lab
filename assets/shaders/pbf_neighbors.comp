#version 430 core
#include "pbf_common.glsl"

layout(local_size_x = PBF_GROUP_SIZE) in;

layout(std430, binding = 1) readonly buffer Predicted { vec4 predicted[]; };
layout(std430, binding = 11) writeonly buffer NeighborListOut { uint neighborListOut[]; };
layout(std430, binding = 10) buffer Stats { uint stats[]; };

// Cached neighbour list, built once per substep. Overflow is counted in stats[4].
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(particleCount))
        return;

    vec3 pi = predicted[i].xyz;
    float h2 = SmoothingRadius() * SmoothingRadius();
    uint base = i * uint(PBF_MAX_NEIGHBORS);
    uint capacity = uint(PBF_MAX_NEIGHBORS - 1);
    uint count = 1u;
    uint dropped = 0u;
    neighborListOut[base + 1u] = i;
    PBF_NEIGHBOR_BEGIN(pi)
        if (j != i)
        {
            vec3 d = pi - predicted[j].xyz;
            if (dot(d, d) < h2)
            {
                if (count < capacity)
                {
                    ++count;
                    neighborListOut[base + count] = j;
                }
                else
                {
                    ++dropped;
                }
            }
        }
    PBF_NEIGHBOR_END
    neighborListOut[base] = count;
    if (dropped > 0u)
        atomicAdd(stats[4], dropped);
}
