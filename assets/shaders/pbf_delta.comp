#version 430 core
#include "pbf_common.glsl"

layout(local_size_x = PBF_GROUP_SIZE) in;

layout(std430, binding = 1) readonly buffer Predicted { vec4 predicted[]; };
layout(std430, binding = 2) readonly buffer Velocities { vec4 velocities[]; };
layout(std430, binding = 3) writeonly buffer Delta { vec4 delta[]; };

// Algorithm 1 lines 12-14: dp_i = (m / rho0) sum_j (lambda_i + lambda_j + s_corr) grad W.
// s_corr is scaled by 1 / D0 to match the paper with physical mass.
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(particleCount))
        return;

    vec3 pi = predicted[i].xyz;
    float lambdaI = velocities[i].w;
    vec3 dp = vec3(0.0);
    PBF_NEIGHBOR_BEGIN(pi)
        if (j != i)
        {
            vec3 r = pi - predicted[j].xyz;
            float r2 = dot(r, r);
            float corr = -sCorrK * pow(Poly6(r2) / wDq, sCorrN) * lambdaScale;
            dp += (lambdaI + velocities[j].w + corr) * SpikyGrad(r, sqrt(r2));
        }
    PBF_NEIGHBOR_END

    delta[i] = vec4(dp * (mass * invRho0), 0.0);
}
