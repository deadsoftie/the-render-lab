#version 430 core
#include "pbf_common.glsl"

layout(local_size_x = PBF_GROUP_SIZE) in;

layout(std430, binding = 0) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding = 2) readonly buffer Velocities { vec4 velocities[]; };
layout(std430, binding = 4) readonly buffer Vorticity { vec4 vorticity[]; };
layout(std430, binding = 5) writeonly buffer VelocitiesOut { vec4 velocitiesOut[]; };

// XSPH and vorticity confinement. eta uses (|w_j| - |w_i|) to avoid a false gradient at the
// surface, and N fades where |w| is flat to avoid amplifying noise.
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(particleCount))
        return;

    vec3 pi = positions[i].xyz;
    vec3 vi = velocities[i].xyz;
    float wi = vorticity[i].w;
    bool confine = vorticityEps > 0.0;
    vec3 smoothing = vec3(0.0);
    vec3 eta = vec3(0.0);
    PBF_NEIGHBOR_BEGIN(pi)
        if (j != i)
        {
            vec3 r = pi - positions[j].xyz;
            float r2 = dot(r, r);
            smoothing += (velocities[j].xyz - vi) * Poly6(r2);
            if (confine)
                eta += (vorticity[j].w - wi) * SpikyGrad(r, sqrt(r2));
        }
    PBF_NEIGHBOR_END

    float volume = mass * invRho0;
    vec3 v = vi + xsphC * volume * smoothing;
    if (confine)
    {
        eta *= volume;
        float len = max(length(eta), wi / SmoothingRadius());
        if (len > 1e-6)
            v += TimeStep() * vorticityEps * cross(eta / len, vorticity[i].xyz);
    }
    velocitiesOut[i] = vec4(v, 0.0);
}
