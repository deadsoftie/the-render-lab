#version 430 core
#include "pbf_common.glsl"

layout(local_size_x = PBF_GROUP_SIZE) in;

layout(std430, binding = 0) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding = 2) readonly buffer Velocities { vec4 velocities[]; };
layout(std430, binding = 4) writeonly buffer Vorticity { vec4 vorticity[]; };

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(particleCount))
        return;

    vec3 pi = positions[i].xyz;
    vec3 vi = velocities[i].xyz;
    vec3 w = vec3(0.0);
    PBF_NEIGHBOR_BEGIN(pi)
        if (j != i)
        {
            vec3 r = pi - positions[j].xyz;
            vec3 gradJ = -SpikyGrad(r, length(r));
            w += cross(velocities[j].xyz - vi, gradJ);
        }
    PBF_NEIGHBOR_END

    w *= mass * invRho0;
    vorticity[i] = vec4(w, length(w));
}
