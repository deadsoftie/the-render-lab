{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake build windows-debug",
      "type": "shell",
      "command": "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cmake --preset windows-debug && cmake --build --preset windows-debug",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "cmake build windows-release",
      "type": "shell",
      "command": "call \"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cmake --preset windows-release && cmake --build --preset windows-release",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "gpuDebug",
      "type": "process",
      "command": "reg",
      "args": [
        "add",
        "HKCU\\Software\\Microsoft\\DirectX\\UserGpuPreferences",
        "/v",
        "${workspaceFolder}\\out\\build\\windows-debug\\the-render-lab.exe",
        "/t",
        "REG_SZ",
        "/d",
        "GpuPreference=2;",
        "/f"
      ],
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "gpuRelease",
      "type": "process",
      "command": "reg",
      "args": [
        "add",
        "HKCU\\Software\\Microsoft\\DirectX\\UserGpuPreferences",
        "/v",
        "${workspaceFolder}\\out\\build\\windows-release\\the-render-lab.exe",
        "/t",
        "REG_SZ",
        "/d",
        "GpuPreference=2;",
        "/f"
      ],
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "debug",
      "dependsOrder": "sequence",
      "dependsOn": ["cmake build windows-debug", "gpuDebug"],
      "problemMatcher": []
    },
    {
      "label": "release",
      "dependsOrder": "sequence",
      "dependsOn": ["cmake build windows-release", "gpuRelease"],
      "problemMatcher": []
    }
  ]
}
