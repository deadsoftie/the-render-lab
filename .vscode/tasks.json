{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake build windows-debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "cmake build windows-release",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$msCompile"]
    }
  ]
}
